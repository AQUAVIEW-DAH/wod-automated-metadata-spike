# Working data — provenance and outputs of a run, not source.
# No placeholders needed: config.py creates raw/, staging/, processed/ and
# staging/manifests/ at import, so a fresh clone builds them itself.
/data/

.venv/
*.egg-info/
/build/
/dist/
__pycache__/
*.pyc
.pytest_cache/

# Per-accession staging scripts (kind = "script" in decisions.toml).
/scripts/

# Test accession lists and notes, not source.
/misc/
